  "memorycode_notes": {
    "title": "MemoryCode, notes after each history (recall eval memorycode)",
    "about": "40 held-out histories (25 short, 15 long), 3 fresh runs each, notes written by chatgpt:gpt-6-luna, judged by Claude Sonnet 5.5 where a convention has no exact token. recall: each convention in its latest form is stated by an active note. updates: a changed convention has its latest form and no replaced form. stale: a replaced form still stated as current. filler: notes learned only from filler sessions. calls and tokens: all three runs.",
    "source": "https://arxiv.org/html/2502.13791v2",
